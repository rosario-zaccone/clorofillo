import unittest
from datetime import datetime
from model.configuration import Configuration
from model.measurement import Measurement
from model.plant_photo import PlantPhoto
from model.photo_type import PhotoType
from model.plant_pot import PlantPot

class TestPlantPot(unittest.TestCase):

    def setUp(self):
        self.configuration = Configuration(threshold=50.0, watering_mode=True, shot_freq=2, insect_freq=10)
        self.measurements = [
            Measurement(timestamp=datetime(2025, 8, 27, 10), soil_moisture=45.0),
            Measurement(timestamp=datetime(2025, 8, 27, 12), soil_moisture=48.0)
        ]
        self.photos = [
            PlantPhoto(timestamp=datetime(2025, 8, 27, 9), photo_type=PhotoType.TIMELAPSE, path="/photos/t1.jpg"),
            PlantPhoto(timestamp=datetime(2025, 8, 27, 10), photo_type=PhotoType.INSECT, path="/photos/i1.jpg"),
            PlantPhoto(timestamp=datetime(2025, 8, 27, 11), photo_type=PhotoType.FLOWER, path="/photos/f1.jpg")
        ]
        self.plant_pot = PlantPot(
            id=1,
            size=12.5,
            plant="Sunflower",
            configuration=self.configuration,
            measurements=self.measurements,
            photos=self.photos
        )

    def test_initial_values(self):
        self.assertEqual(self.plant_pot.id, 1)
        self.assertEqual(self.plant_pot.size, 12.5)
        self.assertEqual(self.plant_pot.plant, "Sunflower")
        self.assertEqual(self.plant_pot.configuration.threshold, 50.0)
        self.assertEqual(len(self.plant_pot.measurements), 2)

    def test_setters(self):
        self.plant_pot.size = 15.0
        self.assertEqual(self.plant_pot.size, 15.0)

        self.plant_pot.plant = "Rose"
        self.assertEqual(self.plant_pot.plant, "Rose")

        new_config = Configuration(threshold=60.0, watering_mode=False, shot_freq=3, insect_freq=12)
        self.plant_pot.configuration = new_config
        self.assertEqual(self.plant_pot.configuration.threshold, 60.0)

    def test_get_timelapse_photos(self):
        timelapse_photos = self.plant_pot.get_timelapse_photos()
        self.assertEqual(len(timelapse_photos), 1)
        self.assertEqual(timelapse_photos[0].path, "/photos/t1.jpg")

    def test_get_insect_photos(self):
        insect_photos = self.plant_pot.get_insect_photos()
        self.assertEqual(len(insect_photos), 1)
        self.assertEqual(insect_photos[0].path, "/photos/i1.jpg")

    def test_get_flower_photos(self):
        flower_photos = self.plant_pot.get_flower_photos()
        self.assertEqual(len(flower_photos), 1)
        self.assertEqual(flower_photos[0].path, "/photos/f1.jpg")

if __name__ == '__main__':
    unittest.main()
